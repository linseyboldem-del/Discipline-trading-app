# Supabase project settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-NEVER-expose-to-frontend

# Anthropic API key for the AI coach (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Your deployed frontend URL, for CORS. Use * only for local dev.
FRONTEND_ORIGIN=http://localhost:5173

PORT=8787

# --- Scanner module ---
# Shared secret your Python MT5 bridge script sends as the X-Scanner-Key
# header when pushing candles. Generate any long random string.
SCANNER_INGEST_KEY=change-me-to-a-long-random-string

# Telegram bot token from @BotFather (only needed if you enable Telegram alerts)
TELEGRAM_BOT_TOKEN=

# How often the background scanner loop runs, in minutes
SCAN_INTERVAL_MINUTES=15

# Set to "false" to disable the automatic background scanner loop
# (useful if you only want to trigger scans manually from the UI)
ENABLE_SCANNER_SCHEDULER=true
